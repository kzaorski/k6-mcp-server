{
  "environment": "development",
  "debug": true,
  "server": {
    "host": "localhost",
    "port": 3000,
    "max_connections": 50,
    "request_timeout": 30
  },
  "security": {
    "audit_log_enabled": true,
    "rate_limit_enabled": false,
    "rate_limit_max_requests": 1000,
    "rate_limit_window_seconds": 60,
    "max_payload_size": 52428800,
    "allowed_hosts": ["localhost", "127.0.0.1", "0.0.0.0"]
  },
  "k6": {
    "k6_binary_path": "k6",
    "default_timeout": "30s",
    "max_virtual_users": 100,
    "max_duration": "1h",
    "results_retention_days": 7,
    "enable_html_reports": true,
    "enable_csv_export": true
  },
  "logging": {
    "level": "DEBUG",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_path": null,
    "max_file_size": 10485760,
    "backup_count": 3,
    "enable_structured_logging": false
  },
  "database": {
    "url": null,
    "pool_size": 5,
    "max_overflow": 10,
    "pool_timeout": 30,
    "enable_query_logging": true
  },
  "performance": {
    "cache_max_size": 10000,
    "cache_ttl_seconds": 3600,
    "circuit_breaker_failure_threshold": 5,
    "circuit_breaker_timeout_seconds": 60,
    "request_throttler_initial_rate": 100.0,
    "request_throttler_min_rate": 10.0,
    "request_throttler_max_rate": 1000.0,
    "metrics_max_samples": 10000,
    "health_check_interval_seconds": 30,
    "memory_gc_threshold_mb": 100
  }
}